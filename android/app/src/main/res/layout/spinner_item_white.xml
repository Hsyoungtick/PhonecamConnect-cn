<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom Spinner item layout — forces white text on the dark app background.
  The default android.R.layout.simple_spinner_item uses ?textColorPrimary which
  follows the system theme and renders black text in light mode, making the
  selected resolution unreadable on the #1E1C18 spinner background.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:singleLine="true"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:textColor="#F0EDE6"
    android:textSize="14sp"/>
